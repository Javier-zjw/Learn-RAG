  {
    "kind": "text",
    "text": "Algorithm 1 Reciprocal Rank Fusion",
    "level": 0,
    "page": 1,
    "bbox": [
      0.08,
      0.619,
      0.369,
      0.635
    ],
    "extra": {
      "mineru_type": "text"
    }
  },
  {
    "kind": "code",
    "text": "Input: ranked lists L1..Lm, weights w, constant k\nfor each document d in union(L1..Lm) do\n    s(d) <- sum_i w_i / (k + rank_i(d))\nend for\nreturn documents sorted by s(d) descending",
    "level": 0,
    "page": 1,
    "bbox": [
      0.092,
      0.647,
      0.546,
      0.714
    ],
    "extra": {}
  },
